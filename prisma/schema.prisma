// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BusinessListing {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  location    String
  credentials String?
  cashFlow    Int
  revenue     Int
  askingPrice Int
  status      String   @default("ACTIVE")
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured, status, sortOrder])
}

model ListingSearchAlert {
  id                 String   @id @default(cuid())
  email              String
  keyword            String?
  industry           String?
  geography          String?
  minimumAskingPrice Int?
  maximumAskingPrice Int?
  minimumCashFlow    Int?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("listing_search_alerts")
}

model BuyerCriteriaRequest {
  id                String   @id @default(cuid())
  fullName          String   @map("full_name")
  contact           String
  targetIndustry    String   @map("target_industry")
  minimumSde        String   @map("minimum_sde")
  liquidEquity      String   @map("liquid_equity")
  geographicFocus   String   @map("geographic_focus")
  targetListingSlug String?  @map("target_listing_slug")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("buyer_criteria_requests")
}

model SellerValuationRequest {
  id                  String   @id @default(cuid())
  fullName            String?  @map("full_name")
  email               String
  phone               String?
  industry            String
  location            String
  annualRevenueRange  String   @map("annual_revenue_range")
  annualCashFlowRange String?  @map("annual_cash_flow_range")
  saleTimeline        String?  @map("sale_timeline")
  preferredContact    String?  @map("preferred_contact")
  contactConsent      Boolean  @map("contact_consent")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("seller_valuation_requests")
}
